# =============================================================================
# Hookpost production environment
# =============================================================================
# Every value marked <<< FILL ME >>> must be supplied by you. Nothing here is
# pre-populated: do not copy credentials from any other project.
#
# In production these are stored in GCP Secret Manager, not in this file.
# See deploy/README.md.
# =============================================================================

# --- Core ---------------------------------------------------------------------
MAIN_URL="https://hookpost.hookstep.in"
FRONTEND_URL="https://hookpost.hookstep.in"
# Relative on purpose: the browser then calls whichever host served the page,
# so one image works via SSH tunnel, bare IP, or the real domain. Set an
# absolute URL only if the API lives on a different origin.
PUBLIC_BACKEND_URL="/api"
NEXT_PUBLIC_BACKEND_URL="https://hookpost.hookstep.in/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
# Generate with: openssl rand -hex 48
JWT_SECRET="<<< FILL ME: openssl rand -hex 48 >>>"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"

# --- Data stores --------------------------------------------------------------
DATABASE_URL="<<< FILL ME: postgresql://USER:PASS@HOST:5432/hookpost >>>"
REDIS_URL="<<< FILL ME: redis://HOST:6379 >>>"

# --- Temporal -----------------------------------------------------------------
# Self-hosted (VM/compose): temporal:7233 with no TLS.
# Temporal Cloud: <namespace>.<acct>.tmprl.cloud:7233, TLS on, API key set.
TEMPORAL_ADDRESS="temporal:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TLS="false"
TEMPORAL_API_KEY=""

# --- Billing: Razorpay --------------------------------------------------------
# From Razorpay Dashboard -> Settings -> API Keys.
# RAZORPAY_KEY_ID doubles as the "billing enabled" flag: leave BOTH blank to run
# the instance in unlimited self-hosted mode with no paywall.
RAZORPAY_KEY_ID="<<< FILL ME: rzp_live_xxxxxxxx >>>"
RAZORPAY_KEY_SECRET="<<< FILL ME >>>"
# Settings -> Webhooks -> the secret you set on the webhook. NOT the API secret.
RAZORPAY_WEBHOOK_SECRET="<<< FILL ME >>>"
# The key id must also be exposed to the browser for Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID="<<< FILL ME: same as RAZORPAY_KEY_ID >>>"
# Optional: a dashboard-created Offer id used for retention discounts.
RAZORPAY_OFFER_ID=""
# Optional: days of free trial before the first charge. 0 disables.
# Days of free trial before the first charge. Blank uses the advertised 7 days;
# set 0 to disable trials (and update the billing copy if you do).
RAZORPAY_TRIAL_DAYS=""

# --- Currency -----------------------------------------------------------------
BILLING_CURRENCY="INR"
NEXT_PUBLIC_BILLING_CURRENCY="INR"
NEXT_PUBLIC_BILLING_CURRENCY_SYMBOL="₹"
BILLING_EMAIL_DOMAIN="hookstep.in"

# --- Storage ------------------------------------------------------------------
# UPLOAD_DIRECTORY is an absolute filesystem path where avatars/media are written.
# Use a PERSISTENT dir (never /tmp — it is wiped on reboot) and make sure NGINX
# serves it at /uploads (see nginx.hookpost.conf) or every avatar/upload 404s.
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/home/flexiple_jr/hookpost-uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/home/flexiple_jr/hookpost-uploads"

# --- Social provider OAuth ----------------------------------------------------
# Each of these is a separate developer-app registration that you must create
# under your own accounts. Blank = that channel is simply unavailable.
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# --- AI -----------------------------------------------------------------------
OPENAI_API_KEY=""

# --- Misc ---------------------------------------------------------------------
API_LIMIT="30"
NX_ADD_PLUGINS="false"

# Published policy URLs. The Terms/Privacy links on the signup form stay hidden
# until BOTH are set. Pages live in the legal pages directory — deploy
# them to hookstep.in first, then these paths resolve.
# NOTE: NEXT_PUBLIC_* is inlined at build time, so changing these needs a rebuild.
NEXT_PUBLIC_TERMS_URL="https://hookstep.in/terms"
NEXT_PUBLIC_PRIVACY_URL="https://hookstep.in/privacy"

# MCP OAuth Dynamic Client Registration allowlist.
# Set deliberately: leaving this empty lets ANY client self-register an OAuth
# app against this instance, which is not a default worth shipping. Restricted
# to the Claude connector; add domains here if you onboard other MCP clients.
# Note this also blocks localhost callbacks (e.g. Claude Code) -- those use the
# API-key /mcp/:id endpoints instead.
DCR_VERIFIED_DOMAINS="claude.ai,claude.com"
